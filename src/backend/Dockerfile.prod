# Production image for the GrandLine FastAPI backend. No --reload; runs as a
# non-root user (matches the chart's securityContext runAsUser: 1000). Scaling
# is horizontal (HPA replicas), so a single uvicorn worker keeps the
# process-local pipeline-task registry coherent.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Non-root runtime user.
RUN useradd --uid 1000 --create-home grandline && chown -R grandline /app
USER 1000

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
